{
  "name": "ai-ppt-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --hot apps/api/src/index.ts",
    "dev:web": "vite",
    "dev:all": "bun run scripts/dev.ts",
    "build": "vite build",
    "start": "bun run apps/api/src/index.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "test:core": "bun test packages/core/tests/",
    "test:api": "bun test apps/api/tests/",
    "test:e2e": "bun test ./e2e/integration.e2e.ts",
    "coverage": "bun test --coverage spec/verify packages/core/tests apps/api/tests",
    "check:coverage": "bun scripts/check-coverage.ts",
    "check:coverage:test": "bun test ./scripts/check-coverage.check.ts",
    "spec": "bun run spec/verify/all.ts",
    "spec:schema": "python3 spec/verify/spec-schema.py",
    "spec:test": "bun test spec/verify/",
    "spec:mutation": "bun run spec/verify/mutation-check.ts",
    "spec:traceability": "bun run spec/verify/traceability.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@google/genai": "^2.32.0",
    "@ppt/core": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "hono": "^4.13.16",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "4.10.38",
    "postgres": "^4.0.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "bun-types": "1.3.11",
    "esbuild": "^0.25.0",
    "jszip": "3.10.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
